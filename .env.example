# Copy to .env, fill in your values, then load it with: source .env
# .env is git-ignored; never commit real tokens.

# Zammad instance URL and API access token (required by all examples).
export URL="https://zammad.example.com"
export TOKEN="your-api-token"

# Date range for examples/ticket/search (created_at filter).
export FROM="2026-12-01"
export TO="2026-12-31"
